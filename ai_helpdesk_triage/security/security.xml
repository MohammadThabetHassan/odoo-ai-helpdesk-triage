<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_ai_helpdesk" model="ir.module.category">
        <field name="name">AI Helpdesk</field>
        <field name="sequence">20</field>
    </record>

    <record id="res_groups_privilege_ai_helpdesk" model="res.groups.privilege">
        <field name="name">AI Helpdesk</field>
        <field name="category_id" ref="module_category_ai_helpdesk"/>
    </record>

    <record id="group_helpdesk_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_ai_helpdesk"/>
    </record>

    <record id="group_helpdesk_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_ai_helpdesk"/>
        <field name="implied_ids" eval="[Command.link(ref('group_helpdesk_user'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_admin'))]"/>
    </record>
</odoo>
