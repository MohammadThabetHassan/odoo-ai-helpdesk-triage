<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_helpdesk_correction_list" model="ir.ui.view">
        <field name="name">ai.helpdesk.correction.list</field>
        <field name="model">ai.helpdesk.correction</field>
        <field name="arch" type="xml">
            <list string="AI Corrections" create="0" edit="0">
                <field name="corrected_at"/>
                <field name="ticket_id"/>
                <field name="field_name"/>
                <field name="ai_value"/>
                <field name="human_value"/>
                <field name="ai_confidence" widget="percentage"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="view_ai_helpdesk_correction_form" model="ir.ui.view">
        <field name="name">ai.helpdesk.correction.form</field>
        <field name="model">ai.helpdesk.correction</field>
        <field name="arch" type="xml">
            <form string="AI Correction" create="0" edit="0">
                <header>
                    <button name="action_open_ticket" type="object" string="Open Ticket" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h2>
                            <field name="field_name"/>
                            <span class="text-muted"> corrected on </span>
                            <field name="ticket_id"/>
                        </h2>
                    </div>
                    <group>
                        <group string="Correction">
                            <field name="ai_value"/>
                            <field name="human_value"/>
                            <field name="ai_confidence" widget="percentage"/>
                        </group>
                        <group string="Metadata">
                            <field name="corrected_at"/>
                            <field name="user_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Ticket Snapshot" name="ticket_snapshot">
                            <group>
                                <field name="ticket_name"/>
                            </group>
                            <separator string="Description at time of triage"/>
                            <field name="ticket_description" nolabel="1" readonly="1"/>
                            <separator string="AI Reasoning"/>
                            <field name="ai_reasoning" nolabel="1" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ai_helpdesk_correction_pivot" model="ir.ui.view">
        <field name="name">ai.helpdesk.correction.pivot</field>
        <field name="model">ai.helpdesk.correction</field>
        <field name="arch" type="xml">
            <pivot string="AI Correction Dashboard">
                <field name="field_name" type="row"/>
                <field name="user_id" type="col"/>
                <field name="id" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_ai_helpdesk_correction_graph" model="ir.ui.view">
        <field name="name">ai.helpdesk.correction.graph</field>
        <field name="model">ai.helpdesk.correction</field>
        <field name="arch" type="xml">
            <graph string="AI Corrections" type="bar">
                <field name="field_name"/>
                <field name="id" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_ai_helpdesk_correction_search" model="ir.ui.view">
        <field name="name">ai.helpdesk.correction.search</field>
        <field name="model">ai.helpdesk.correction</field>
        <field name="arch" type="xml">
            <search string="Search AI Corrections">
                <field name="ticket_id"/>
                <field name="field_name"/>
                <field name="user_id"/>
                <group>
                    <filter string="Field" name="group_field" context="{'group_by': 'field_name'}"/>
                    <filter string="Reviewer" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Correction Date" name="group_date" context="{'group_by': 'corrected_at'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ai_helpdesk_correction" model="ir.actions.act_window">
        <field name="name">AI Corrections</field>
        <field name="res_model">ai.helpdesk.correction</field>
        <field name="view_mode">graph,pivot,list,form</field>
    </record>
</odoo>
