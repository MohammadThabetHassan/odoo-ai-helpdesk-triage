<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_helpdesk_ticket_pivot_resolution" model="ir.ui.view">
        <field name="name">ai.helpdesk.ticket.pivot.resolution</field>
        <field name="model">ai.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <pivot string="AI Resolution Report">
                <field name="category" type="row"/>
                <field name="ai_resolution_status" type="col"/>
                <field name="id" type="measure" string="Ticket Count"/>
                <field name="ai_resolution_duration_minutes" type="measure" string="Avg Duration (min)"/>
            </pivot>
        </field>
    </record>

    <record id="view_ai_helpdesk_ticket_graph_resolution" model="ir.ui.view">
        <field name="name">ai.helpdesk.ticket.graph.resolution</field>
        <field name="model">ai.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <graph string="AI Resolution Report" type="bar">
                <field name="category" type="row"/>
                <field name="ai_resolution_duration_minutes" type="measure" string="Avg Duration (min)"/>
            </graph>
        </field>
    </record>

    <record id="action_ai_helpdesk_resolution_report" model="ir.actions.act_window">
        <field name="name">AI Resolution Report</field>
        <field name="res_model">ai.helpdesk.ticket</field>
        <field name="view_mode">pivot,graph</field>
        <field name="domain">[('ai_resolution_status', '=', 'resolved')]</field>
        <field name="context">{'search_default_group_category': 1}</field>
    </record>

    <menuitem id="menu_ai_helpdesk_resolution_report" name="Reports" parent="menu_ai_helpdesk_root" action="action_ai_helpdesk_resolution_report" sequence="30"/>
</odoo>
