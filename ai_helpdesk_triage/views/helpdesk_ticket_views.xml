<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_helpdesk_ticket_form" model="ir.ui.view">
        <field name="name">ai.helpdesk.ticket.form</field>
        <field name="model">ai.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <form string="Support Ticket">
                <header>
                    <button name="action_ai_triage" type="object" string="AI Triage" class="btn-primary"
                            invisible="state != 'new' or ai_triage_attempted"
                            confirm="Let the AI agent analyze this ticket and suggest classification, team, and reply?"/>
                    <button name="action_ai_resolve" type="object" string="AI Resolve" class="btn-primary"
                            invisible="state != 'ai_triaged' or ai_resolution_status not in ('not_attempted','failed')"
                            confirm="Let the AI attempt to resolve this ticket by calling tools? Actions will be logged."/>
                    <button name="action_assign" type="object" string="Assign" class="btn-primary"
                            invisible="state != 'ai_triaged'"/>
                    <button name="action_start_progress" type="object" string="Start" class="btn-primary"
                            invisible="state != 'assigned'"/>
                    <button name="action_resolve" type="object" string="Resolve" class="btn-primary"
                            invisible="state != 'in_progress'"/>
                    <button name="action_close" type="object" string="Close"
                            invisible="state != 'resolved'"/>
                    <button name="action_reset_new" type="object" string="Reset to New"
                            invisible="state == 'new' and not ai_triage_attempted and not ai_error"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="new,ai_triaged,assigned,in_progress,resolved,closed"/>
                </header>
                <sheet>
                    <field name="ai_triaged" invisible="1"/>
                    <field name="ai_triage_attempted" invisible="1"/>
                    <field name="ai_error" invisible="1"/>
                    <field name="ai_review_status" invisible="1"/>

                    <div class="alert alert-warning mb-3" role="alert"
                         invisible="ai_review_status != 'review_recommended'">
                        <i class="fa fa-exclamation-triangle me-1" title="Warning"/>
                        <strong>Review recommended.</strong>
                        AI routed this ticket but confidence is below the auto-route threshold.
                    </div>
                    <div class="alert alert-danger mb-3" role="alert"
                         invisible="ai_review_status != 'needs_human'">
                        <i class="fa fa-user-o me-1" title="Needs human"/>
                        <strong>Needs human triage.</strong>
                        AI confidence is below the review threshold; the ticket remains New.
                    </div>

                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-percent" invisible="not ai_triaged">
                            <field name="ai_confidence_percent" widget="statinfo" string="Confidence"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-cogs" type="object"
                                name="action_view_actions" invisible="action_count == 0">
                            <field name="action_count" widget="statinfo" string="Actions"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Cannot log in to my account"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="partner_email" readonly="1"/>
                            <field name="category"/>
                            <field name="priority" widget="priority"/>
                            <field name="satisfaction" readonly="state not in ('resolved', 'closed')"/>
                        </group>
                        <group>
                            <field name="team_id"/>
                            <field name="user_id"/>
                            <field name="ai_model" invisible="1"/>
                            <field name="ai_triaged_date" readonly="1" invisible="not ai_triaged"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Describe the customer's issue in detail."/>
                        </page>
                        <page string="AI Analysis" name="ai_analysis" invisible="not ai_triaged">
                            <group>
                                <group string="Signals">
                                    <field name="ai_confidence_percent" widget="progressbar" readonly="1"/>
                                    <field name="ai_review_status" widget="badge" readonly="1"
                                           decoration-success="ai_review_status == 'accepted'"
                                           decoration-warning="ai_review_status == 'review_recommended'"
                                           decoration-danger="ai_review_status == 'needs_human'"/>
                                </group>
                            </group>
                            <field name="ai_input_tokens" invisible="1"/>
                            <field name="ai_output_tokens" invisible="1"/>
                            <field name="ai_total_cost" invisible="1"/>
                            <separator string="Reasoning"/>
                            <field name="ai_reasoning" nolabel="1" readonly="1"
                                   placeholder="AI reasoning will appear here after triage."/>
                            <separator string="Suggested Reply"/>
                            <field name="ai_suggested_reply" nolabel="1"
                                   placeholder="Human-editable draft reply."/>
                        </page>
                        <page string="AI Error" name="ai_error_page" invisible="not ai_error">
                            <field name="ai_error" readonly="1" nolabel="1"/>
                        </page>
                        <page string="AI Actions" name="ai_actions" invisible="action_count == 0">
                            <group>
                                <group>
                                    <field name="ai_resolution_status" widget="badge"
                                           decoration-success="ai_resolution_status == 'resolved'"
                                           decoration-warning="ai_resolution_status in ('escalated','in_progress')"
                                           decoration-danger="ai_resolution_status == 'failed'"/>
                                    <field name="ai_resolution_attempts"/>
                                </group>
                                <group>
                                    <field name="ai_resolution_reason"/>
                                </group>
                            </group>
                            <field name="ai_resolution_cost" invisible="1"/>
                            <separator string="Agent Notes"/>
                            <field name="ai_resolution_reasoning" nolabel="1" readonly="1"/>
                            <separator string="Tool Timeline"/>
                            <field name="action_ids" nolabel="1" readonly="1">
                                <list decoration-success="succeeded" decoration-danger="not succeeded">
                                    <field name="sequence"/>
                                    <field name="tool_name"/>
                                    <field name="succeeded" widget="boolean_toggle" readonly="1"/>
                                    <field name="error_message" optional="show"/>
                                    <field name="create_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_ai_helpdesk_ticket_list" model="ir.ui.view">
        <field name="name">ai.helpdesk.ticket.list</field>
        <field name="model">ai.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <list string="Support Tickets"
                  decoration-danger="priority == '3' or ai_review_status == 'needs_human'"
                  decoration-warning="priority == '2' or ai_review_status == 'review_recommended'"
                  decoration-muted="state == 'closed'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="category" optional="show"/>
                <field name="priority" widget="priority"/>
                <field name="team_id" optional="show"/>
                <field name="user_id" optional="show"/>
                <field name="ai_confidence_percent" widget="progressbar" optional="hide"/>
                <field name="ai_review_status" widget="badge" optional="hide"
                       decoration-success="ai_review_status == 'accepted'"
                       decoration-warning="ai_review_status == 'review_recommended'"
                       decoration-danger="ai_review_status == 'needs_human'"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'new'"
                       decoration-primary="state == 'ai_triaged'"
                       decoration-warning="state in ('assigned','in_progress')"
                       decoration-success="state in ('resolved','closed')"/>
                <field name="create_date" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_ai_helpdesk_ticket_kanban" model="ir.ui.view">
        <field name="name">ai.helpdesk.ticket.kanban</field>
        <field name="model">ai.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" sample="1">
                <templates>
                    <field name="team_id" invisible="1"/>
                    <field name="ai_triaged" invisible="1"/>
                    <field name="ai_review_status" invisible="1"/>
                    <field name="ai_resolution_status" invisible="1"/>
                    <t t-name="card">
                        <field name="name" class="fw-bold fs-5"/>
                        <field name="partner_id" class="text-muted"/>
                        <div class="mt-1 small" invisible="not team_id">
                            <i class="fa fa-users me-1" title="Team"/>
                            <field name="team_id"/>
                        </div>
                        <div class="mt-2" invisible="not ai_triaged">
                            <field name="ai_confidence_percent" widget="progressbar"/>
                        </div>
                        <div class="mt-2 d-flex gap-1 flex-wrap">
                            <span class="badge text-bg-success" invisible="ai_review_status != 'accepted'">Auto-routed</span>
                            <span class="badge text-bg-warning" invisible="ai_review_status != 'review_recommended'">Review</span>
                            <span class="badge text-bg-danger" invisible="ai_review_status != 'needs_human'">Needs Human</span>
                            <span class="badge text-bg-success" invisible="ai_resolution_status != 'resolved'">AI Resolved</span>
                            <span class="badge text-bg-warning" invisible="ai_resolution_status != 'escalated'">Escalated</span>
                            <span class="badge text-bg-danger" invisible="ai_resolution_status != 'failed'">Resolution Failed</span>
                        </div>
                        <footer class="pt-1 mt-0">
                            <field name="priority" widget="priority"/>
                            <field name="user_id" widget="many2one_avatar_user" class="ms-auto"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_ai_helpdesk_ticket_search" model="ir.ui.view">
        <field name="name">ai.helpdesk.ticket.search</field>
        <field name="model">ai.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <search string="Search Tickets">
                <field name="name" string="Subject"/>
                <field name="partner_id"/>
                <field name="team_id"/>
                <field name="user_id"/>
                <field name="description"/>
                <separator/>
                <filter string="My Tickets" name="my_tickets" domain="[('user_id','=',uid)]"/>
                <filter string="Unassigned" name="unassigned" domain="[('user_id','=',False)]"/>
                <filter string="Open" name="open" domain="[('state','not in',('resolved','closed'))]"/>
                <separator/>
                <filter string="Not Yet Triaged" name="not_triaged" domain="[('ai_triaged','=',False)]"/>
                <filter string="AI Triaged" name="triaged" domain="[('ai_triaged','=',True)]"/>
                <filter string="Review Recommended" name="review_recommended"
                        domain="[('ai_review_status','=','review_recommended')]"/>
                <filter string="Needs Human" name="needs_human"
                        domain="[('ai_review_status','=','needs_human')]"/>
                <separator/>
                <filter string="Urgent" name="urgent" domain="[('priority','=','3')]"/>
                <filter string="Unhappy" name="unhappy" domain="[('satisfaction','=','unhappy')]"/>
                <group>
                    <filter string="Satisfaction" name="group_satisfaction" context="{'group_by': 'satisfaction'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Category" name="group_category" context="{'group_by': 'category'}"/>
                    <filter string="Priority" name="group_priority" context="{'group_by': 'priority'}"/>
                    <filter string="Team" name="group_team" context="{'group_by': 'team_id'}"/>
                    <filter string="Assignee" name="group_user" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ai_helpdesk_ticket" model="ir.actions.act_window">
        <field name="name">Tickets</field>
        <field name="res_model">ai.helpdesk.ticket</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first support ticket</p>
            <p>Let the AI Triage Agent classify, prioritize, route, and draft a reply for human review.</p>
        </field>
    </record>
</odoo>
